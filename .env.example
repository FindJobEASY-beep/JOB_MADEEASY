PORT=3000
PRICE_RUPEES=20

# From Razorpay Dashboard → Account & Settings → API Keys
# Test keys start with rzp_test_ and do not charge real money.
# Live keys start with rzp_live_ and need a completed Razorpay KYC.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Optional. Dashboard → Account & Settings → Webhooks
# URL: https://your-domain/api/webhook
# Event: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Set to 1 when the app is behind a host like Render or Railway
TRUST_PROXY=0

# Password for /admin. At least 8 characters. This confirms payments.
ADMIN_PASSWORD=choose_a_long_password

# Optional. You can also save the UPI ID from the admin page.
UPI_ID=
UPI_NAME=The Hiring File
